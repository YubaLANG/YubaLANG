# YubaLANG 1.2 Interpreter Regression Program
# Copyleft 🄯 2026 YubaLANG Technologies

# --------------------------------
# Variable Definitions
# --------------------------------
define var x: int = 10
define var y: int = 5
define var name: string = "what is good"
define var pi: float = 3.14
define var cool: bool = true
define var my_list: list = ['apple', 'banana', 'cherry']
define var num_list: list = [10, 25, 5]
define var list_item: string = ""
define var list_len: int = 0
define var loop_flag: bool = true

# Auxiliary variables for new built-in function tests
define var truthy_list: list = [1, 2, 3]
define var mixed_list: list = [0, 1, 0]
define var falsy_list: list = [0, 0, 0]
define var res_bool: bool = false
define var str_type: string = ""
define var val_len: int = 0
define var memory_id: int = 0

# Variables for Collections, I/O, Bytes, and Attributes
define var my_dict: dict = {'lang': 'YubaLANG', 'version': 2026}
define var dict_val: string = ""
define var my_set: set = {'alpha', 'beta'}
define var my_tuple: tuple = ('red', 'green', 'blue')
define var tuple_item: string = ""
define var raw_bytes: bytes = "hello"
define var raw_barray: bytearray = "world"
define var attr_has: bool = false
define var attr_val: string = ""

# --------------------------------
# Arithmetic Operations
# --------------------------------
text output "Testing addition (10 + 5):"
arith add x y

text output "Testing modulo (10 mod 3):"
arith mod x 3

text output "Testing abs with -10:"
arith abs -10

text output "Testing max of 10 and 5:"
arith max x y

text output "Testing min of 10 and 5:"
arith min x y

text output "Testing round of 3.14:"
arith round pi

text output "Testing sum of list [10, 25, 5]:"
arith sum num_list

text output "Testing max of list [10, 25, 5]:"
arith max num_list

text output "Testing min of list [10, 25, 5]:"
arith min num_list

# --- New Math & Number Functions ---
text output "Testing bin of 10:"
arith bin x

text output "Testing hex of 255:"
arith hex 255

text output "Testing oct of 64:"
arith oct 64

text output "Testing pow of 10^5:"
arith pow x y

text output "Testing divmod of 10 and 3:"
arith divmod x 3

# --------------------------------
# Text Output
# --------------------------------
text output "Hello, YubaLANG!"
text output name
text output pi
text output cool

# --------------------------------
# List & Collection Operations
# --------------------------------
list append my_list "dragonfruit"
list get my_list 1 list_item
text output list_item

list len my_list list_len
text output list_len

# --- New Collections: Dict, Set, Tuple ---
text output "--- Starting Dictionary, Set, & Tuple tests ---"

dict get my_dict "lang" dict_val
text output "dict get my_dict['lang'] (should be YubaLANG):"
text output dict_val

dict set my_dict "status" "awesome"
dict get my_dict "status" dict_val
text output "dict get my_dict['status'] after dict set:"
text output dict_val

set add my_set "gamma"
len my_set val_len
text output "len(my_set) after adding 'gamma' (should be 3):"
text output val_len

tuple get my_tuple 0 tuple_item
text output "tuple get my_tuple[0] (should be red):"
text output tuple_item

# --------------------------------
# Testing Bytes & Bytearray
# --------------------------------
text output "--- Starting Bytes and Bytearray tests ---"
bytes "hyper" raw_bytes
type raw_bytes str_type
text output "Type of raw_bytes:"
text output str_type

bytearray "lang" raw_barray
type raw_barray str_type
text output "Type of raw_barray:"
text output str_type

# --------------------------------
# Testing Object & Attribute Utilities
# --------------------------------
text output "--- Starting Object & Attribute Utility tests ---"

hasattr my_dict "lang" attr_has
text output "hasattr(my_dict, 'lang') (should be true):"
text output attr_has

getattr my_dict "lang" attr_val
text output "getattr(my_dict, 'lang') (should be YubaLANG):"
text output attr_val

setattr my_dict "author" "YubaLANG Team"
getattr my_dict "author" attr_val
text output "getattr(my_dict, 'author') after setattr:"
text output attr_val

# --------------------------------
# Testing File I/O (open)
# --------------------------------
text output "--- Starting File I/O (open) tests ---"
open "tests/interpreter_regression.tmp" "w" file_handle
type file_handle str_type
text output "Type of file_handle after open():"
text output str_type

# --------------------------------
# Loop Operations
# --------------------------------
text output "Testing loop for:"
loop for 3
    text output "Looping!"
endloop

text output "Testing loop while:"
loop while loop_flag
    text output "Inside while loop"
    define var loop_flag: bool = false
endloop

# --------------------------------
# Function Operations
# --------------------------------
text output "Testing functions:"
func define test_function
    text output "Running code inside test_function!"
    arith mul x y
endfunc

func call test_function

# --------------------------------
# Compare Operations
# --------------------------------
text output "Testing comparisons:"
define var a: int = 10
define var b: int = 20
define var is_less: bool = false

compare a < b is_less
text output "Is 10 < 20?"
text output is_less

# --------------------------------
# Testing If / Else Blocks
# --------------------------------
text output "--- Starting conditional block tests ---"

define var money: int = 50
define var item_cost: int = 100
define var can_afford: bool = false
define var exactly_fifty: bool = false

compare money >= item_cost can_afford
compare money == 50 exactly_fifty

if can_afford
    text output "You bought the item!"
elseif exactly_fifty
    text output "You have exactly 50 dollars, saving it up."
else
    text output "You cannot afford this right now."
endif

# --------------------------------
# Testing Type Conversion (Convert)
# --------------------------------
text output "--- Starting type conversion tests ---"

define var str_num: string = "42"
text output "Converting string '42' to int and adding 8:"
convert str_num to int
arith add str_num 8

define var float_val: float = 9.99
text output "Converting float 9.99 to int:"
convert float_val to int
text output float_val

define var bool_val: bool = true
text output "Converting bool 'true' to string:"
convert bool_val to string
text output bool_val

# --------------------------------
# Testing Built-in Functions
# --------------------------------
text output "--- Starting built-in function tests ---"

# 1. Testing all()
all truthy_list res_bool
text output "all([1, 2, 3]) (should be true):"
text output res_bool

all mixed_list res_bool
text output "all([0, 1, 0]) (should be false):"
text output res_bool

# 2. Testing any()
any mixed_list res_bool
text output "any([0, 1, 0]) (should be true):"
text output res_bool

any falsy_list res_bool
text output "any([0, 0, 0]) (should be false):"
text output res_bool

# 3. Testing bool()
bool x res_bool
text output "bool(10) (should be true):"
text output res_bool

bool 0 res_bool
text output "bool(0) (should be false):"
text output res_bool

# 4. Testing callable()
callable test_function res_bool
text output "callable('test_function') (should be true):"
text output res_bool

callable non_existent_func res_bool
text output "callable('non_existent_func') (should be false):"
text output res_bool

# 5. Testing id()
id x memory_id
text output "id(x) integer representation:"
text output memory_id

# 6. Testing len()
len name val_len
text output "len('what is good') (should be 12):"
text output val_len

len my_list val_len
text output "len(my_list) (should be 4):"
text output val_len

# 7. Testing type()
type pi str_type
text output "type(pi) (should be float):"
text output str_type

type my_list str_type
text output "type(my_list) (should be list):"
text output str_type

# 8. Testing vars()
text output "Testing vars():"
vars

# --------------------------------
# Testing Return Operations
# --------------------------------
text output "--- Starting return tests ---"

define var do_early_exit: bool = true

func define early_bird
    text output "Starting the function..."

    if do_early_exit
        text output "Exiting early!"
        return
    endif

    text output "You will not see this text because we returned!"
endfunc

func call early_bird
text output "Back in main script!"

# --------------------------------
# Testing Global and Local Scope
# --------------------------------
text output "--- Starting scope tests ---"

define var scope_test_var: int = 100

func define scope_tester
    text output "Inside function, creating local variable with same name..."
    define var scope_test_var: int = 500
    text output "Local scope_test_var is:"
    text output scope_test_var
    text output "Printing vars inside local function scope:"
    vars
endfunc

text output "Global scope_test_var before function:"
text output scope_test_var

func call scope_tester

text output "Global scope_test_var after function (should still be 100):"
text output scope_test_var

# --------------------------------
# Testing Wait, Break, and Continue
# --------------------------------
text output "--- Starting control flow tests ---"

text output "Testing wait... pausing for 2 seconds."
wait 2
text output "Done waiting!"

text output "Testing continue:"
define var skip_it: bool = true

loop for 4
    if skip_it
        text output " -> Skipping this iteration..."
        define var skip_it: bool = false
        continue
        text output "ERROR: This continue line should never print!"
    endif

    text output " -> Executing full iteration!"
    define var skip_it: bool = true
endloop

text output "Testing break:"
define var infinite: bool = true

loop while infinite
    text output " -> Inside the while loop. Breaking out immediately!"
    break
    text output "ERROR: This break line should never print!"
endloop

text output "Successfully escaped the loop!"
